# Public build-time settings. Leave API origin empty for local Vite proxying.
# For GitHub Pages: VITE_BASE_PATH=/openvoice/
VITE_BASE_PATH=/
VITE_API_ORIGIN=

# Server-only Boson credential. Never prefix this with VITE_.
BOSON_API_KEY=bai-replace-me
PORT=8787
HOST=127.0.0.1
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Public demo default: 300 provider calls/day across all visitors, including retries.
# This is an abuse guard, not a dollar budget; resets on restart or at UTC midnight.
DAILY_PROVIDER_REQUEST_LIMIT=300

# Never put provider credentials in a VITE_ variable.
# Keep secrets in the server runtime environment.
